POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://sentimentor:changeme@localhost:5432/sentimentor

# Coordinator key for admin operations
# ADMIN_KEY=<generated by tools/generate_key.py>

# Worker locations for the status map (city-level coordinates, not street addresses)
# WORKER_LOCATIONS='{"scraper-1": {"lat": 21.3626, "lon": -158.0848, "label": "Makakilo"}, "scraper-2": {"lat": 21.3364, "lon": -158.0654, "label": "Kapolei"}, "sentiment-1": {"lat": 21.3364, "lon": -158.0654, "label": "Kapolei"}}'

# Scraper worker API keys (add to coordinator/keys.json too)
# SCRAPER_KEY_1=<generated by tools/generate_key.py>
# SCRAPER_KEY_2=<generated by tools/generate_key.py>

# Sentiment worker API key (add to coordinator/keys.json too)
# SENTIMENT_KEY=<generated by tools/generate_key.py>

# Scraper worker
# MAX_TEXT_CHARS: safety rail on stored text, not a design target
MAX_TEXT_CHARS=500000
# GOTO_TIMEOUT: ms to wait for page load (tries networkidle, falls back to domcontentloaded)
GOTO_TIMEOUT=30000
# WAIT_MS: ms to wait after page load before extracting (±500-1000ms jitter applied)
WAIT_MS=3000
# FETCH_TIMEOUT: seconds before the fetch subprocess is hard-killed
FETCH_TIMEOUT=120

# Sentiment worker
LLM_CHUNK_CHARS=4000
LLM_BACKEND=openrouter
LLM_MODEL=google/gemma-4-31b-it:free
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MAX_RETRIES=3
LLM_TIMEOUT=120
SENTIMENT_BATCH_SIZE=20
PROMPT_VERSION=v1

# Coordinator
# MAX_SCRAPE_ATTEMPTS: max failed scrape attempts per URL per cycle before skipping until next cycle
MAX_SCRAPE_ATTEMPTS=3
# CYCLE_URL_LIMIT: if set, only this many URLs are activated per cycle (useful for testing/dev)
CYCLE_URL_LIMIT=
